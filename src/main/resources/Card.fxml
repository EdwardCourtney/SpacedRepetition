<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="review-card" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.morrello.spacedrepetition.controller.CardController">
   <padding>
      <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
   </padding>
   <children>
      <VBox spacing="3.0" HBox.hgrow="ALWAYS">
         <children>
            <Label fx:id="titleLabel" styleClass="card-title" text="Subject - Lesson" />
            <Label fx:id="dayLabel" text="Day:" />
            <Label fx:id="repeatedLabel" text="Repeated:" />
         </children>
      </VBox>
      <VBox spacing="6.0" styleClass="card-actions">
         <children>
            <Button fx:id="primaryButton" mnemonicParsing="false" text="Done" />
            <Button fx:id="secondaryButton" mnemonicParsing="false" text="More" />
         </children>
      </VBox>
   </children>
</HBox>
